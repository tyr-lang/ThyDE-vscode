{
    "name": "thyde",
    "publisher": "feldentm",
    "repository": {
        "type": "git",
        "url": "git://github.com/tyr-lang/ThyDE-vscode.git"
    },
    "private": true,
    "displayName": "ThyDE",
    "description": "Tyr Development Environment",
    "version": "0.2.18",
    "engines": {
        "vscode": "^1.135.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "tyr",
            "aliases": ["Type Research Language", "tyr"],
            "extensions": [".tyr"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "tyr",
            "scopeName": "source.tyr",
            "path": "./syntaxes/tyr.tmLanguage.json"
        }]
    }
}
