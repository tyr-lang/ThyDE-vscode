{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Type Research Language",
	"patterns": [
		{
			"include": "#constants"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#storage"
		},
		{
			"include": "#stringsRaw"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#characters"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#variables"
		}
	],
	"repository": {
		"constants": {
			"patterns": [{
				"name": "constant.language",
				"match": "\\b(false|true|null)\\b"
			},{
				"name": "constant.numeric",
				"match": "(((-?\\d+)|(0x[0-9a-fA-F]+))(((i|f)\\d*)|L|U|(u\\d*))?)|(-\\d*\\.\\d+([eE]-?\\d+)?(f\\d*)?)"
			}]
		},
		"comments": {
			"patterns": [{
				"name": "comment.line",
				"begin":"//",
				"end":"$"
			},{
				"name": "comment.block.documentation",
				"begin":"/\\*\\*",
				"end":"\\*/"
			},{
				"name": "comment.block",
				"begin":"/\\*",
				"end":"\\*/"
			}]
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.tyr",
				"match": "\\b(break|catch|continue|do|else|finally|if|return|switch|throw|try|while)\\b"
			},{
				"name": "keyword.operator",
				"match": "\\b(:|:=|=|<:)\\b"
			},{
				"name": "keyword.control.other",
				"match": "\\b(var|val|let|def|test|new|delete|extern|with)\\b"
			}]
		},
		"storage": {
			"patterns": [{
				"name": "storage.type",
				"match": "\\b(enum|type|class|interface|property)\\b"
			},{
				"name": "storage.modifier",
				"match": "\\b(public|protected|private|override)\\b"
			}]
		},
		"variables": {
			"patterns": [{
				"name": "variable.other.tyr",
				"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*|`[^`]+`)\\b"
			}]
		},
		"characters": {
			"patterns": [
				{
					"name": "keyword.operator",
					"match": "\\b`[\\u0021\\u0023-\\u0026\\u002a\\u002b\\u002d\\u002f\\u003a\\u003c-\\u0040\\u005c\\u005e\\u007c\\u007e]+`\\b"
				},
				{
					"name": "constant.character.literal",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.tyr",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.tyr",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.tyr",
					"match": "\\\\."
				}
			]
		},
		"stringsRaw": {
			"name": "string.quoted.triple.tyr",
			"begin": "\"\"\"",
			"end": "\"\"\""
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator",
					"match": "\\b(,|\\.|;)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator",
					"match": "\\b([\\u0021\\u0023-\\u0026\\u002a\\u002b\\u002d\\u002f\\u003a\\u003c-\\u0040\\u005c\\u005e\\u007c\\u007e]+)\\b"
				}
			]
		}
	},
	"scopeName": "file"
}
