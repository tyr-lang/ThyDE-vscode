{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Type Research Language",
	"scopeName": "source.tyr",
	"fileTypes": [".tyr"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#characters" },
		{ "include": "#literals" },
		{ "include": "#keywords" },
		{ "include": "#storage" },
		{ "include": "#types" },
		{ "include": "#modifiers" },
		{ "include": "#punctuation" },
		{ "include": "#operators" },
		{ "include": "#identifiers" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.tyr",
					"begin": "//",
					"end": "$",
					"patterns": [
						{ "name": "punctuation.definition.comment.tyr", "match": "//" }
					]
				},
				{
					"name": "comment.block.documentation.tyr",
					"begin": "/\\*\\*",
					"end": "\\*/",
					"patterns": [
						{ "name": "punctuation.definition.comment.tyr", "match": "/\\*\\*|\\*/" },
						{ "name": "entity.other.attribute-name.tag.doc.tyr", "match": "@[a-zA-Z_][a-zA-Z0-9_]*(?=\\s|:|$)" },
						{ "name": "variable.parameter.doc.tyr", "match": "@[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\-)" }
					]
				},
				{
					"name": "comment.block.tyr",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{ "name": "punctuation.definition.comment.tyr", "match": "/\\*|\\*/" }
					]
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.triple.tyr",
					"begin": "\"\"\"",
					"end": "\"\"\"",
					"patterns": [
						{ "name": "constant.character.escape.tyr", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.double.tyr",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.tyr", "match": "\\\\." }
					]
				}
			]
		},
		"characters": {
			"patterns": [
				{
					"name": "constant.character.tyr",
					"begin": "'",
					"end": "'",
					"patterns": [
						{ "name": "constant.character.escape.tyr", "match": "\\\\." }
					]
				}
			]
		},
		"literals": {
			"patterns": [
				{ "name": "constant.numeric.float.tyr", "match": "(?:\\d+(_\\d+)*\\.\\d+(_\\d+)*|\\.\\d+(_\\d+)*)(?:[eE][-+]?\\d+(_\\d+)*)?(?:[fF]\\d*)?" },
				{ "name": "constant.numeric.integer.tyr", "match": "(0[xX][0-9a-fA-F]+(_[0-9a-fA-F]+)*|(?:\\d+(_\\d+)*))(?:[iI]\\d*|[fF]\\d*|[uU]\\d*|L)?" },
				{ "name": "constant.language.boolean.tyr", "match": "\\b(true|false)\\b" },
				{ "name": "constant.language.null.tyr", "match": "\\bnull\\b" }
			]
		},
		"keywords": {
			"patterns": [
				{ "name": "keyword.control.tyr", "match": "\\b(break|catch|continue|do|else|finally|if|return|switch|throw|try|while)\\b" },
				{ "name": "keyword.operator.new-delete.tyr", "match": "\\b(new|delete)\\b" },
				{ "name": "keyword.other.tyr", "match": "\\b(def|test|with|extern)\\b" }
			]
		},
		"storage": {
			"patterns": [
				{ "name": "storage.type.variable.tyr", "match": "\\b(var|val|let)\\b" }
			]
		},
		"types": {
			"patterns": [
				{ "name": "storage.type.class.tyr", "match": "\\b(class|interface)\\b" },
				{ "name": "storage.type.enum.tyr", "match": "\\benum\\b" },
				{ "name": "storage.type.property.tyr", "match": "\\bproperty\\b" },
				{ "name": "storage.type.tyr", "match": "\\btype\\b" }
			]
		},
		"modifiers": {
			"patterns": [
				{ "name": "storage.modifier.access.tyr", "match": "\\b(public|protected|private)\\b" },
				{ "name": "storage.modifier.override.tyr", "match": "\\boverride\\b" }
			]
		},
		"punctuation": {
			"patterns": [
				{ "name": "punctuation.definition.block.begin.tyr", "match": "\\{" },
				{ "name": "punctuation.definition.block.end.tyr", "match": "\\}" },
				{ "name": "punctuation.definition.parameters.begin.tyr", "match": "\\(" },
				{ "name": "punctuation.definition.parameters.end.tyr", "match": "\\)" },
				{ "name": "punctuation.definition.brackets.begin.tyr", "match": "\\[" },
				{ "name": "punctuation.definition.brackets.end.tyr", "match": "\\]" },
				{ "name": "punctuation.separator.tyr", "match": "," },
				{ "name": "punctuation.terminator.tyr", "match": ";" },
				{ "name": "punctuation.accessor.tyr", "match": "\\." }
			]
		},
		"operators": {
			"patterns": [
				{ "name": "keyword.operator.assignment.tyr", "match": ":=" },
				{ "name": "keyword.operator.assignment.tyr", "match": "=" },
				{ "name": "keyword.operator.type.tyr", "match": "<:" },
				{ "name": "keyword.operator.as.tyr", "match": ":" },
				{ "name": "keyword.operator.tyr", "match": "[!#%&*+\\\\/<=>@\\^|~-]+" }
			]
		},
		"identifiers": {
			"patterns": [
				{ "name": "variable.other.backtick.tyr", "match": "`[^`]+`" },
				{ "name": "variable.other.tyr", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" },
				{ "name": "variable.language.blank.tyr", "match": "_" }
			]
		}
	}
}
